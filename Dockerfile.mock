FROM ubuntu:22.04

# snmpd       – SNMP agent
# iputils-ping – ping for traffic generation
# iproute2    – ip link for virtual interfaces (requires NET_ADMIN cap)
# python3     – pass_persist UCD simulator script
RUN apt-get update && apt-get install -y \
    snmpd \
    iputils-ping \
    iproute2 \
    python3 \
    && rm -rf /var/lib/apt/lists/*

# Bake in the pass_persist UCD simulator and the entrypoint
COPY ucd-sim /usr/local/sbin/ucd-sim
COPY mock-entrypoint.sh /mock-entrypoint.sh
RUN chmod +x /usr/local/sbin/ucd-sim /mock-entrypoint.sh

EXPOSE 161/udp

ENTRYPOINT ["/mock-entrypoint.sh"]